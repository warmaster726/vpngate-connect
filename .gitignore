# ==============================================================================
# vpngate-connect — Pure-Rust Cross-Platform Desktop Edition
# Targets: Linux, Windows 11 & macOS
# ==============================================================================

# --- 1. Rust & Cargo Build Artifacts ---
# Note: Cargo.lock is intentionally tracked for reproducible --locked source builds.
/target/
**/target/
**/*.rs.bk
*.pdb
*.dwo
*.profraw
*.profdata
lcov.info

# --- 2. Desktop Packages & Compiled Binaries ---
Thumbs.db
Desktop.ini
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.exp
*.msi
*.msix
*.deb
*.rpm
*.AppImage
*.pkg.tar.zst
*.dmg

# --- 3. Ephemeral VPN Configs, Caches, Logs & Secrets (Never Commit) ---
*.ovpn
*.mobileconfig
*.pbk
*.pem
*.key
*.der
*.pfx
*.log
.env
.env.*
*token*.txt
*secret*
servers_cache*.json
mirrors_cache*.json
cooldowns*.json

# --- 4. Editor & Python Launcher Scratch Files ---
__pycache__/
**/__pycache__/
*.py[cod]
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
.vscode/*
!.vscode/extensions.json
