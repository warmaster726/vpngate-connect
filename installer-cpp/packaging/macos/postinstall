#!/bin/sh
# pkgbuild postinstall: build and install the Rust VPN Gate client from source.
set -eu

TARGET_VOLUME=${3:-/}
if [ "$TARGET_VOLUME" != "/" ]; then
  echo "VPN Gate Connect must be installed onto the currently booted macOS volume." >&2
  exit 1
fi

HELPER="$TARGET_VOLUME/Library/Application Support/VPN Gate Connect Installer/vpngate-installer.app/Contents/MacOS/vpngate-installer"
if [ ! -x "$HELPER" ]; then
  echo "VPN Gate Connect installer helper is missing: $HELPER" >&2
  exit 1
fi

# Do not run an x86_64 helper under Rosetta on Apple Silicon or an ARM64 helper
# on Intel. The package matrix ships a native installer for each architecture.
HELPER_ARCHES=$(/usr/bin/lipo -archs "$HELPER" 2>/dev/null || true)
ARM_CAPABLE=$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || printf '0')
if [ "$ARM_CAPABLE" = "1" ]; then
  EXPECTED_ARCH=arm64
else
  EXPECTED_ARCH=x86_64
fi
case " $HELPER_ARCHES " in
  *" $EXPECTED_ARCH "*) ;;
  *)
    echo "This package contains a $HELPER_ARCHES installer; this Mac requires $EXPECTED_ARCH. Download the matching .pkg." >&2
    exit 1
    ;;
esac

TARGET_HOME=""
CONSOLE_USER=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
case "$CONSOLE_USER" in
  ""|root|loginwindow|_mbsetupuser)
    ;;
  *)
    TARGET_HOME=$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null \
      | /usr/bin/sed 's/^NFSHomeDirectory: //' || true)
    if [ ! -d "$TARGET_HOME" ]; then
      TARGET_HOME=""
    fi
    ;;
esac

set -- install --yes --remove-toolchain
if [ -n "$TARGET_HOME" ]; then
  set -- "$@" --target-home "$TARGET_HOME"
  export SUDO_USER="$CONSOLE_USER"
else
  # Homebrew refuses to run as root on unattended/no-console package installs.
  set -- "$@" --skip-openvpn
fi

"$HELPER" "$@"
