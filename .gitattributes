# Normalize text line endings consistently across Linux, macOS & Windows
* text=auto

# Unix LF endings for Rust, Flutter/Dart, configs, scripts & mobile build files
*.rs        text eol=lf
*.toml      text eol=lf
*.lock      text eol=lf
*.dart      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.desktop   text eol=lf
*.gradle    text eol=lf
*.kts       text eol=lf
*.kt        text eol=lf
*.swift     text eol=lf
*.h         text eol=lf
*.c         text eol=lf
*.m         text eol=lf
*.mm        text eol=lf
*.plist     text eol=lf
*.xml       text eol=lf
LICENSE     text eol=lf

# Windows CRLF endings for PowerShell & Batch scripts
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary assets
*.png       binary
*.jpg       binary
*.ico       binary
*.icns      binary
*.jar       binary
*.TTF       binary
*.ttf       binary
*.otf       binary
